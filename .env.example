# LLM provider, pick one and fill in its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# "<provider>:<model>", e.g. openai:gpt-5.5, anthropic:claude-opus-5-5 or google_genai:gemini-3.5-flash
LLM_MODEL=openai:gpt-5.5

# Optional, without this the agent only has mock research data for two
# demo topics (see data/sample_research/topics.json)
TAVILY_API_KEY=
